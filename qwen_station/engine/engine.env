# Pins of this release. provision.sh installs exactly these; serve.sh reads the folder names.
ENGINE_VERSION=1.3.0

VLLM_VERSION=0.32.0
PYTHON_VERSION=3.12
UV_VERSION=0.12.9
# nvcc and friends for the FlashInfer kernel JIT (installed with pip into its own folder, no system CUDA needed)
CUDA_SDK_PACKAGES="nvidia-cuda-nvcc==13.4.92 nvidia-cuda-crt==13.4.92 nvidia-nvvm==13.4.92 nvidia-cuda-runtime==13.4.92 nvidia-curand==10.4.0.35"
# Prebuilt FlashInfer kernels: package flashinfer-jit-cache-<arch>==<flashinfer version>+<cuda label>
KERNEL_INDEX=https://flashinfer.ai/whl/cu130
KERNEL_CUDA=cu130
KERNEL_ARCH=sm120f

TARGET_REPO=gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090
TARGET_REV=5b7a687fc8211a5d631c8ca6a593dd37eb26ce33
TARGET_DIR=Qwen3.8-27B-NVFP4-RTX5090-Gittensor
TARGET_BYTES=17950000000

DRAFTER_REPO=TechPrototyper/Qwen3.8-27B-DFlash2-fp8-vllm
DRAFTER_REV=a59c3ad40eab93501e7704dfe154e7c33e6633ff
DRAFTER_DIR=Qwen3.8-27B-DFlash2-FP8
DRAFTER_BYTES=2260000000

# Optional second target (preset "Unsloth NVFP4"): provision.sh model-unsloth
UNSLOTH_REPO=unsloth/Qwen3.8-27B-NVFP4
UNSLOTH_REV=f0b7c9e722f5565102fff8481c99e4d86ae099c7
UNSLOTH_DIR=Qwen3.8-27B-NVFP4-Unsloth
UNSLOTH_BYTES=23450000000
